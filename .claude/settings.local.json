{
  "permissions": {
    "allow": [
      "Bash(dir:*)",
      "Bash(powershell:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(ls:*)",
      "Bash(cd:*)",
      "Bash(type:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(echo:*)",
      "Bash(git:*)",
      "Bash(tsc:*)",
      "Bash(vite:*)",
      "Bash(timeout:*)",
      "Bash(python:*)",
      "Bash(zip:*)",
      "Bash(curl:*)",
      "Bash(./gradlew.bat:*)",
      "Bash(gradlew.bat:*)",
      "Bash(java:*)",
      "Bash(set:*)",
      "Bash(export:*)",
      "Bash(rm:*)",
      "Bash(wc:*)"
    ]
  },
  "project": {
    "name": "迷你西游梦",
    "description": "西游题材单机文字RPG游戏（参考梦幻西游）",
    "techStack": [
      "React 19",
      "TypeScript 5.8",
      "Vite 6",
      "Tailwind CSS 4",
      "Preact Signals",
      "Dexie.js",
      "PWA",
      "Capacitor"
    ],
    "features": [
      "五行系统（金木水火土）",
      "回合制战斗",
      "宠物系统（捕捉、合宠、打书）",
      "装备系统（强化、套装）",
      "剧情任务（12章）",
      "成就系统（79个成就）"
    ],
    "docsPath": "minixiyoudream/docs",
    "specsPath": "minixiyoudream/specs",
    "srcPath": "minixiyoudream/src"
  },
  "mcpServers": {
    "web-reader": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@anthropic-ai/web-reader-mcp"
      ]
    }
  }
}
